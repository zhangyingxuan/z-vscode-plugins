{
  "name": "stock-ticker",
  "version": "1.0.0",
  "private": true,
  "main": "dist/main.cjs",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --external:electron --external:pay-back-core --outfile=dist/main.cjs && esbuild src/renderer.jsx --bundle --minify --outfile=dist/renderer.js",
    "start": "npm run build && electron .",
    "test": "node --test"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "electron": "45.5.0",
    "esbuild": "0.28.2"
  }
}
