{
  "name": "stock-ticker",
  "displayName": "Stock Ticker - 指数观测",
  "description": "秒级指数指标监控",
  "version": "1.0.0",
  "publisher": "blowsysun",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "stock-ticker.showChart",
        "title": "上证指数: 查看分时图"
      },
      {
        "command": "stock-ticker.refresh",
        "title": "上证指数: 刷新数据",
        "icon": "$(refresh)"
      },
      {
        "command": "stock-ticker.manageBoardQueries",
        "title": "上证指数: 管理看板问答语句"
      }
    ],
    "keybindings": [
      {
        "command": "stock-ticker.refresh",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r"
      },
      {
        "command": "stock-ticker.showChart",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v"
      }
    ],
    "configuration": {
      "title": "Stock Ticker",
      "properties": {
        "stock-ticker.refreshInterval": {
          "type": "number",
          "default": 1,
          "description": "行情数据刷新间隔（秒），交易时间内生效"
        },
        "stock-ticker.boardAutoRefresh": {
          "type": "boolean",
          "default": false,
          "description": "是否自动刷新新高/新低看板（默认关闭，避免无谓请求）"
        },
        "stock-ticker.boardRefreshInterval": {
          "type": "number",
          "default": 300,
          "description": "看板自动刷新间隔（秒），仅当 boardAutoRefresh 开启且处于交易时段时生效"
        },
        "stock-ticker.boardQueries": {
          "type": "object",
          "default": {
            "sectorHigh": "同花顺行业新高",
            "sectorLow": "同花顺行业新低",
            "sectorNotNewLow": "同花顺行业未创新低",
            "stockHigh": "创60日新高的个股 非ST",
            "stockLow": "创60日新低的个股 非ST",
            "stockNotNewLow": "未创60日新低的个股 非ST"
          },
          "description": "新高/新低/不创新低看板的爱问财问答语句（板块、个股各三条），可在分时图面板点「问句管理」修改",
          "properties": {
            "sectorHigh": {
              "type": "string",
              "description": "板块新高问句"
            },
            "sectorLow": {
              "type": "string",
              "description": "板块新低问句"
            },
            "sectorNotNewLow": {
              "type": "string",
              "description": "板块不创新低问句"
            },
            "stockHigh": {
              "type": "string",
              "description": "个股新高问句"
            },
            "stockLow": {
              "type": "string",
              "description": "个股新低问句"
            },
            "stockNotNewLow": {
              "type": "string",
              "description": "个股不创新低问句"
            }
          }
        },
        "stock-ticker.customBoards": {
          "type": "array",
          "default": [],
          "description": "用户自定义看板（问句管理页可增删改）；每项为 { id, name, question, module }，module 为 sector(板块)/stock(个股) 归属模块",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string",
                "description": "看板显示名称"
              },
              "question": {
                "type": "string",
                "description": "爱问财问答语句"
              },
              "module": {
                "type": "string",
                "enum": [
                  "sector",
                  "stock"
                ],
                "description": "归属看板模块：sector(板块) / stock(个股)"
              }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run bundle",
    "compile": "tsc -p ./",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --format=cjs --outfile=out/extension.js --external:vscode --sourcemap",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "package": "npx vsce package --no-dependencies",
    "build": "npm run compile && npm run bundle && npm run package"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.74.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "pay-back-core": "^0.0.17"
  }
}
